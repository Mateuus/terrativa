# Runtime
NODE_ENV=development
APP_ORIGIN=http://localhost:5173
API_ORIGIN=http://localhost:2567
WS_ORIGIN=ws://localhost:2567
GAME_SERVER_HOST=0.0.0.0
GAME_SERVER_PORT=2567
LOG_LEVEL=info
ACCESS_TOKEN_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
REFRESH_TOKEN_PEPPER=REPLACE_WITH_AT_LEAST_32_RANDOM_BYTES
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30

# Existing local database. Values belong only in an untracked .env.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=CHANGE_ME
DB_PASS=CHANGE_ME
DB_NAME=terrativa_development

REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Optional alternatives used by CI/container environments.
# DATABASE_URL=mysql://USER:PASSWORD@HOST:PORT/DATABASE
# SHADOW_DATABASE_URL=mysql://ROOT_USER:ROOT_PASSWORD@HOST:PORT/SHADOW_DATABASE
# REDIS_URL=redis://HOST:PORT
