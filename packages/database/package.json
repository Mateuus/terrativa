{
  "name": "@terrativa/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "seed:foundation": "tsx src/seedFoundation.ts",
    "schema:validate": "prisma validate"
  },
  "dependencies": {
    "@terrativa/board-content": "workspace:*",
    "@prisma/adapter-mariadb": "7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2",
    "mariadb": "3.5.3"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "prisma": "^7.9.0",
    "tsx": "4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
