{
  "name": "@terrativa/board-content",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "browser": "./dist/browser.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./foundation": {
      "types": "./dist/foundation.d.ts",
      "browser": "./dist/foundation.js",
      "import": "./dist/foundation.js",
      "default": "./dist/foundation.js"
    },
    "./characters": {
      "types": "./dist/characters.d.ts",
      "browser": "./dist/characters.js",
      "import": "./dist/characters.js",
      "default": "./dist/characters.js"
    },
    "./geography": {
      "types": "./dist/geography.d.ts",
      "browser": "./dist/geography.js",
      "import": "./dist/geography.js",
      "default": "./dist/geography.js"
    },
    "./modules": {
      "types": "./dist/registry.d.ts",
      "browser": "./dist/registry.js",
      "import": "./dist/registry.js",
      "default": "./dist/registry.js"
    },
    "./scene": {
      "types": "./dist/scene.d.ts",
      "browser": "./dist/scene.js",
      "import": "./dist/scene.js",
      "default": "./dist/scene.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
